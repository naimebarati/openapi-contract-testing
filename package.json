{
  "name": "openapi-contract-testing",
  "version": "0.1.0-beta.1",
  "description": "Framework-agnostic OpenAPI response contract testing for Node.js: check real HTTP responses against OpenAPI 3.0, 3.1 and 3.2 documents.",
  "keywords": [
    "openapi",
    "contract-testing",
    "api-testing",
    "json-schema",
    "jest",
    "vitest",
    "supertest"
  ],
  "license": "MIT",
  "author": "naimebarati <naimebarati@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naimebarati/openapi-contract-testing.git"
  },
  "bugs": {
    "url": "https://github.com/naimebarati/openapi-contract-testing/issues"
  },
  "homepage": "https://github.com/naimebarati/openapi-contract-testing#readme",
  "type": "module",
  "sideEffects": [
    "./dist/jest.js",
    "./dist/jest.cjs",
    "./dist/vitest.js",
    "./dist/vitest.cjs"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "third-party"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:types": "tsc --noEmit -p tests/type-tests/tsconfig.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run test:dist && npm run test:types && npm run test:jest",
    "test:dist": "node scripts/smoke-dist.mjs",
    "test:jest": "jest --config tests/integration/jest/jest.config.cjs",
    "test:pack": "node scripts/pack-smoke.mjs",
    "bench": "node benchmarks/run.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "axios": "^1.21.0",
    "eslint": "^10.13.0",
    "expect-type": "^1.4.0",
    "express": "^5.3.0",
    "fastify": "^5.12.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapters/fetch": {
      "import": {
        "types": "./dist/adapters/fetch.d.ts",
        "default": "./dist/adapters/fetch.js"
      },
      "require": {
        "types": "./dist/adapters/fetch.d.cts",
        "default": "./dist/adapters/fetch.cjs"
      }
    },
    "./adapters/supertest": {
      "import": {
        "types": "./dist/adapters/supertest.d.ts",
        "default": "./dist/adapters/supertest.js"
      },
      "require": {
        "types": "./dist/adapters/supertest.d.cts",
        "default": "./dist/adapters/supertest.cjs"
      }
    },
    "./adapters/axios": {
      "import": {
        "types": "./dist/adapters/axios.d.ts",
        "default": "./dist/adapters/axios.js"
      },
      "require": {
        "types": "./dist/adapters/axios.d.cts",
        "default": "./dist/adapters/axios.cjs"
      }
    },
    "./adapters/fastify": {
      "import": {
        "types": "./dist/adapters/fastify.d.ts",
        "default": "./dist/adapters/fastify.js"
      },
      "require": {
        "types": "./dist/adapters/fastify.d.cts",
        "default": "./dist/adapters/fastify.cjs"
      }
    },
    "./jest": {
      "import": {
        "types": "./dist/jest.d.ts",
        "default": "./dist/jest.js"
      },
      "require": {
        "types": "./dist/jest.d.cts",
        "default": "./dist/jest.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/vitest.d.ts",
        "default": "./dist/vitest.js"
      },
      "require": {
        "types": "./dist/vitest.d.cts",
        "default": "./dist/vitest.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "expect": "^30.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "expect": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
